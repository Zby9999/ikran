{
  "name": "recursive-design-agent",
  "version": "0.1.0-alpha.1",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.13",
    "npm": ">=11.6.2"
  },
  "bin": {
    "ikran": "bin/ikran.mjs",
    "ikran-mcp": "bin/ikran-mcp.mjs"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build && node lib/runtime/version-stamp.mjs",
    "start": "node bin/ikran.mjs",
    "start:prod": "node bin/ikran.mjs --prod",
    "setup:product": "npm ci --omit=dev && node scripts/release/prune-product-install.mjs && npx --no-install playwright-core install chromium && npm run build",
    "setup:contributor": "npm ci && npx --no-install playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:quick",
    "test:quick": "npm run typecheck && npm run test:unit",
    "test:full": "npm run check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "release:build": "node scripts/release/build.mjs --kit all --out-dir dist/release",
    "release:gate": "node scripts/release/gate.mjs --clean all --out-dir dist/release"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "figma-squircle": "^1.1.0",
    "next": "^16.3.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.26",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tldraw": "^5.2.3",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "undici": "^7.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "shadcn": "^4.13.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1"
  }
}
